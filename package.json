{
  "name": "streamer-tracker",
  "version": "1.1.0",
  "description": "등록한 치지직/SOOP 스트리머의 방송 여부를 확인하는 웹/exe/모바일 앱",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mobile-web": "node scripts/build-mobile-web.js",
    "mobile:sync": "npm run build:mobile-web && cap sync android",
    "mobile:open": "cap open android"
  },
  "build": {
    "appId": "com.streamertracker.app",
    "productName": "StreamerTracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-full.png"
    },
    "portable": {
      "artifactName": "StreamerTracker-${version}-portable.exe"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
