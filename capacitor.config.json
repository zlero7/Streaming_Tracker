{
  "appId": "com.streamertracker.app",
  "appName": "방송 체크",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "com.streamertracker.app.check",
      "src": "runners/runner.js",
      "event": "checkStreamers",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
